# ============================================================
# AGENTE EXTRACT — variáveis de ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NUNCA deve ser enviado para o Git ou
# compartilhado — ele fica apenas na máquina do servidor.
# ============================================================

# Chave secreta do Flask para proteger as sessões de login.
# O rodar_gamatec.bat gera uma chave aleatória automaticamente no primeiro
# arranque; para trocar à mão:
#   python -c "import secrets; print(secrets.token_hex(32))"
GAMATEC_SECRET_KEY=coloque_aqui_uma_chave_longa_e_aleatoria

# Diretório raiz do projeto — NÃO precisa ser definido.
# O padrão é a pasta onde está este arquivo, por isso funciona em qualquer
# caminho de instalação. Só preencha se os dados ficarem noutra pasta:
# GAMATEC_BASE_DIR=C:\caminho\completo\do\projeto
