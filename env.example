# ============================================================
# AGENTE EXTRACT — variáveis de ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NUNCA deve ser enviado para o Git ou
# compartilhado — ele fica apenas na máquina do servidor.
# ============================================================

# Chave secreta do Flask para proteger as sessões de login.
# Gere um valor forte e aleatório. Exemplo pelo terminal:
#   python -c "import secrets; print(secrets.token_hex(32))"
GAMATEC_SECRET_KEY=coloque_aqui_uma_chave_longa_e_aleatoria

# Diretório raiz do projeto.
# Se não informado, o sistema usa a pasta onde está o config.py.
# Exemplo Windows:
GAMATEC_BASE_DIR=C:\robo_gamatec_oc
